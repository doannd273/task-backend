# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/task_manager

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_REFRESH_SECRET=change_this_to_another_strong_random_secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Email (Gmail SMTP — dùng App Password, không phải password Gmail thường)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Forgot password delivery mode
# "console" → in OTP ra terminal (local dev, không cần SMTP)
# "email"   → gửi email thật (cần EMAIL_USER + EMAIL_PASS)
PASSWORD_RESET_OTP_DELIVERY=console

# Device ID hashing (tùy chọn — nếu để trống thì không log device hash)
DEVICE_ID_HASH_SECRET=

# Firebase / FCM
# Đặt path đến serviceAccountKey.json nếu không để file ở config/serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=

# Public base URL (tự động detect nếu để trống)
PUBLIC_BASE_URL=
DEV_BASE_API_HOST=
