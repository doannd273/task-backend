meta {
  name: Change Password
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/user/changePassword
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "{{newPassword}}"
  }
}
