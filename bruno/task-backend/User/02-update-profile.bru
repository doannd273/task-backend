meta {
  name: Update Profile
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/user/updateProfile
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "fullName": "{{fullName}}",
    "phone": "{{phone}}",
    "avatar": "{{avatarUrl}}"
  }
}
