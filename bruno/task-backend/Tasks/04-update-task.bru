meta {
  name: Update Task
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/tasks/updateTask/{{taskId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept-Language: {{language}}
  X-Request-Id: {{requestId}}
  X-App-Version-Code: {{appVersionCode}}
  X-App-Version-Name: {{appVersionName}}
  X-Platform: {{platform}}
  X-OS-Version: {{osVersion}}
  X-Device-Model: {{deviceModel}}
  X-Device-Id: {{deviceId}}
  User-Agent: {{userAgent}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "title": "Updated sample task",
    "description": "Updated from Bruno",
    "status": "in_progress",
    "dueDate": "2026-06-02T00:00:00.000Z"
  }
}
