meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "fullName": "{{fullName}}"
  }
}

script:post-response {
  const body = res.getBody();
  const accessToken = body?.data?.accessToken;
  const refreshToken = body?.data?.refreshToken;

  if (accessToken) {
    bru.setEnvVar("accessToken", accessToken, { persist: true });
  }

  if (refreshToken) {
    bru.setEnvVar("refreshToken", refreshToken, { persist: true });
  }
}
